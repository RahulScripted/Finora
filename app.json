{
  "expo": {
    "name": "Finora",
    "slug": "finora",
    "version": "1.0.0",
    "scheme": "finora",
    "orientation": "portrait",
    "icon": "./assets/png/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/png/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finora.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/png/android-icon-foreground.png",
        "backgroundImage": "./assets/png/android-icon-background.png",
        "monochromeImage": "./assets/png/android-icon-monochrome.png"
      },
      "package": "com.finora.app",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/png/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/png/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/png/notification-icon.png",
          "color": "#ffffff",
          "defaultChannel": "transactions",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
